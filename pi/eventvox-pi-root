#!/bin/bash
# Wat de agent als root mag (via sudo, zie /etc/sudoers.d/eventvox-pi): de Pi herstarten, bijwerken (alles, of alleen
# EventVOX-Pi: update-app), en de wifi-netwerken
# en SSH-sleutels uit EventVOX zetten (via stdin, gecontroleerd door wifi.py en ssh.py).
case "${1:-}" in
  reboot) exec systemctl reboot ;;
  update) exec systemctl start --no-block eventvox-pi-update.service ;;
  update-app) exec systemctl start --no-block eventvox-pi-update-app.service ;;
  wifi) exec /usr/bin/python3 /opt/eventvox-pi/wifi.py ;;
  ssh) exec /usr/bin/python3 /opt/eventvox-pi/ssh.py ;;
  *) echo "Gebruik: eventvox-pi-root reboot|update|update-app|wifi|ssh" >&2; exit 2 ;;
esac
