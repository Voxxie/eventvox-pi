#!/bin/bash
# Nagebootst systemctl voor de tests, zoals het echte: is-active geeft per dienst de staat uit $FAKE_SYSTEMCTL/<dienst>
# (anders inactive), één regel per dienst, en afsluitcode 0 alleen als er een "active" is. Een eenmalige dienst die
# bezig is, is "activating".
if [ "$1" = is-active ]; then
  shift
  code=3
  for unit in "$@"; do
    state="$(cat "${FAKE_SYSTEMCTL:?}/$unit" 2>/dev/null || echo inactive)"
    echo "$state"
    [ "$state" = active ] && code=0
  done
  exit "$code"
fi
exit 0
